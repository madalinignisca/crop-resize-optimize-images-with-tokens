# --- imgd configuration (copy to .env; .env is gitignored) ---

# HMAC secret used to sign/verify tokens. Prefer *_FILE (a mounted secret) over
# inline values in real deployments. One of IMG_SECRET / IMG_SECRET_FILE is
# REQUIRED.
IMG_SECRET=change-me-to-a-long-random-string
# IMG_SECRET_FILE=/run/secrets/img_secret

# Secret rotation: during a transition window set the previous secret here.
# Tokens signed with either secret verify; new tokens are signed with IMG_SECRET.
# IMG_SECRET_PREVIOUS=previous-secret
# IMG_SECRET_PREVIOUS_FILE=/run/secrets/img_secret_previous

# Bytes of the HMAC-SHA256 kept in tokens: 32 = full (default, conservative),
# 16 = truncated 128-bit (shorter URLs, still infeasible to forge).
# IMG_SIGNATURE_BYTES=32

# Source images. src identifiers in tokens are resolved within this directory;
# traversal outside it is rejected even for validly-signed tokens. REQUIRED.
IMG_SOURCE_DIR=/srv/images
# Optional regexp the (cleaned) src must fully match, e.g. only product jpg/png:
# IMG_SOURCE_ALLOW=^products/[0-9]+\.(jpg|jpeg|png)$
# IMG_MAX_SOURCE_BYTES=52428800   # reject source files larger than this (50 MiB)

# Generated-image cache directory. REQUIRED. No eviction in v1.
IMG_CACHE_DIR=/var/cache/imgd

# Server-side clamps (defense in depth against decompression-bomb renders).
# IMG_MAX_WIDTH=4000
# IMG_MAX_HEIGHT=4000
# IMG_MAX_OUTPUT_PIXELS=24000000   # cap on output width*height
# IMG_MAX_SOURCE_PIXELS=100000000  # reject sources larger than this many pixels
# IMG_DEFAULT_QUALITY=82

# HTTP listeners.
IMG_PUBLIC_ADDR=:8080
# Leave IMG_INTERNAL_ADDR unset to DISABLE the HTTP signing endpoint entirely
# (sign in-process via the token package instead). If set, bind it to a private
# interface and/or protect it with IMG_INTERNAL_TOKEN.
# IMG_INTERNAL_ADDR=127.0.0.1:8081
# IMG_INTERNAL_TOKEN=shared-header-secret-for-/internal/sign
# IMG_INTERNAL_TOKEN_FILE=/run/secrets/img_internal_token

# Absolute base prepended to URLs returned by /internal/sign. Empty = relative.
# IMG_PUBLIC_BASE_URL=https://img.example.com

# Cache-Control max-age (seconds) on served images. Default 1 year.
# IMG_CACHE_MAX_AGE=31536000
